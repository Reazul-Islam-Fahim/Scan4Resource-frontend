# Base URL of the backend API, without a trailing slash.
# Leave empty to run in demo mode (simulated detections, schedules kept in the browser).
VITE_API_URL=

# Set to true to force demo mode even when VITE_API_URL is set.
VITE_USE_MOCK=false

# Development only: let the Vite dev server forward /api to the backend, so the browser never makes a
# cross-origin call (no CORS setup needed). Set VITE_API_URL=/api and point API_TARGET at the backend.
# API_TARGET=http://localhost:8000

# Address of the logistics app (Scan4Resource-logistics-frontend), without a trailing slash. Logistics companies
# are sent there after logging in, and the logistics app sends people here to log in. Locally: http://localhost:5174
VITE_LOGISTICS_URL=
